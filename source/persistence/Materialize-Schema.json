{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "retold-faceting-service/Materialize-Schema.json",
	"title": "RetoldFaceting.Materialize",
	"description": "Which entities a store mirrors and how (internal-contracts §55.1). Draft by the M5 contracts pass; builder A owns it. Keys the design names but M5 does not build (PathColumns, RelationFields, Rollups, Aggregates, Dictionary) are accepted here and ignored with an 'Unsupported:<Key>' warning.",
	"type": "object",
	"propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
	"additionalProperties": { "$ref": "#/definitions/EntityDeclaration" },
	"definitions":
	{
		"Identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
		"ColumnList": { "type": "array", "items": { "$ref": "#/definitions/Identifier" }, "maxItems": 1000 },
		"EntityDeclaration":
		{
			"type": "object",
			"required": [ "Store" ],
			"additionalProperties": false,
			"properties":
			{
				"Store": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": [ "ClickHouse", "Solr", "OpenSearch" ] } },
				"Columns": { "oneOf": [ { "type": "string", "enum": [ "Auto" ] }, { "$ref": "#/definitions/ColumnList" } ] },
				"IncludeColumns": { "$ref": "#/definitions/ColumnList" },
				"ExcludeColumns": { "$ref": "#/definitions/ColumnList" },
				"SortKey": { "type": "string", "enum": [ "Auto" ] },
				"Watermark": { "oneOf": [ { "type": "string", "enum": [ "Auto", "UpdateDate" ] }, { "type": "boolean", "enum": [ false ] } ] },
				"Mutability": { "type": "string", "enum": [ "Mutable", "AppendOnly" ] },
				"PathColumns": { "type": "object" },
				"RelationFields": { "type": "object" },
				"Rollups": { "type": "object" },
				"Aggregates": { "type": "object" },
				"Dictionary": { "type": "boolean" }
			}
		}
	}
}
