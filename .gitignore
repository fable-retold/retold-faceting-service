# Dependencies resolve from the retold umbrella node_modules; never install here
node_modules

# Build output
dist

# Per-agent build notes (not part of the package)
.build-notes

# Coverage
coverage
.nyc_output

# Test databases
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
*.log
.DS_Store

# Example applications: quackage-generated build config (regenerated by `npx quack build`)
example_applications/*/.babelrc
example_applications/*/.browserslistrc
example_applications/*/.browserslistrc-BACKUP
example_applications/*/.gulpfile-quackage.js
example_applications/*/.gulpfile-quackage-config.json
example_applications/*/.package.json.quackage.bak
example_applications/*/package-lock.json
